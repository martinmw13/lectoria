# Copy to .env.local and fill in. Never commit real values.
# Owner key: funds the public chat and images within the per-person quota and the global cap. Once a person's quota is used, they may bring their own key (BYOK), which comes from the browser per request and is never stored. A BYOK request uses only the user's key.
META_API_KEY=
# Model: muse-spark-1.3-contributor in dev, muse-spark-1.3 in public
META_MODEL=
# Cleaning judge model override (dev default: muse-spark-1.3-contributor)
CLEAN_MODEL=
# Cleaning judge on a Modal Shared Endpoint: full chat-completions URL (not secret)
MODAL_CLEAN_URL=
# Bearer token for the Modal Shared Endpoint above
MODAL_CLEAN_TOKEN=
# Cleaning judge model on Modal (default: meta-models/Muse-Spark-Open-816B-A42B)
MODAL_CLEAN_MODEL=
# Jev API key for emotion classification
JEV_API_KEY=
# Pinned: jev-1.14.0
JEV_MODEL=
# Baseten API key for the offline pipeline
BASETEN_API_KEY=
# Owner machine only, for deploying Modal apps; never in Vercel
MODAL_TOKEN_ID=
# Owner machine only, for deploying Modal apps; never in Vercel
MODAL_TOKEN_SECRET=
# Modal proxy auth for the Glimmer and MusicGen endpoints; sent as Modal-Key / Modal-Secret headers
MODAL_PROXY_TOKEN_ID=
# Modal proxy auth for the Glimmer and MusicGen endpoints; sent as Modal-Key / Modal-Secret headers
MODAL_PROXY_TOKEN_SECRET=
# Deployed Glimmer endpoint URL on Modal; the endpoint requires proxy auth
GLIMMER_URL=
# Upstash Redis REST URL for quotas (fallback: KV_REST_API_URL, injected by Vercel)
UPSTASH_REDIS_REST_URL=
# Fallback when UPSTASH_REDIS_REST_URL is empty
KV_REST_API_URL=
# Upstash Redis REST token for quotas
# (fallback: KV_REST_API_TOKEN, injected by Vercel; the read-only token is unused, we write)
UPSTASH_REDIS_REST_TOKEN=
# Fallback when UPSTASH_REDIS_REST_TOKEN is empty
KV_REST_API_TOKEN=
# HMAC key for the anonymous cookie
SESSION_SECRET=
# Salt for hashed IPs
IP_HASH_SALT=
# Turnstile secret for the per-session check
TURNSTILE_SECRET_KEY=
# Turnstile site key, public and safe to expose in the browser
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Blob store token for generated images
BLOB_READ_WRITE_TOKEN=
# Localhost only (ignored on Vercel): without Blob + Redis, generated images
# are cached on disk here (absolute path; default ~/.cache/lectoria/images)
LECTORIA_IMAGE_CACHE_DIR=
# Localhost only: set to 1 to use the disk cache even when Blob + Redis are set
LECTORIA_LOCAL_IMAGE_CACHE=
# Separate PRIVATE Blob store for uploads. The owner creates it by hand in
# the Vercel dashboard: a store's access mode is fixed at creation, and the
# image store above is public, so private upload puts would fail against it.
UPLOADS_BLOB_READ_WRITE_TOKEN=
# Global image and chat spend cap in USD (integer micro-dollars, default 10)
SPEND_CAP_USD=
# Optional friend codes (comma-separated) raising free uploads to five books a day
LECTORIA_FRIEND_CODES=
# Offline narration spend cap in USD for one pipeline run (default 2)
NARRATION_CAP_USD=
# Bearer token for the daily upload-cleanup cron route
CRON_SECRET=
