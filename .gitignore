# Build output and caches
node_modules/
.next/
out/
dist/
coverage/
.vercel/
*.tsbuildinfo
# Generated by `next dev`, `next build`, or `npx next typegen`; never edit.
next-env.d.ts

# Secrets (never commit these; see .env.example for names)
.env
.env.local
.env.*.local
*.pem

# Local noise
.DS_Store
*.log

# Book sources (only processed public-domain JSON is committed)
*.epub
# Synthetic upload-validation fixtures (scripts/make-epub-fixtures.mjs).
!core/fixtures/epub/*.epub
data/raw/
pipeline/out/
# Resume scratch for the bookmap pass; bookmap.json itself is committed
bookmap.cache.json
