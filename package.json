{
  "name": "lectoria-meta",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:book": "tsx pipeline/build.ts",
    "enrich": "tsx pipeline/enrich.ts",
    "build:music": "tsx pipeline/labels-to-manifest.ts",
    "clean:epub": "tsx pipeline/clean-epub.ts",
    "narrate": "tsx pipeline/narrate-cli.ts",
    "pregen:covers": "tsx --conditions=react-server scripts/pregen-covers.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:isolation": "node scripts/check-isolation.mjs",
    "check:size": "node scripts/check-file-size.mjs",
    "check:data": "node scripts/validate-books.mjs",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "test:hooks": "node --test scripts/*.test.mjs",
    "muse:stats": "node scripts/muse-stats.mjs",
    "deploy:prod": "npx vercel@latest deploy --prod --yes"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "fflate": "0.8.3",
    "modal": "0.11.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "tsx": "^4.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
